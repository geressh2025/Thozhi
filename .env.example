# ─── LLM Configuration (Optional) ────────────────────────────────────────────
# The application works WITHOUT these — the fallback engine handles everything.

# Option 1: Google Gemini
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-1.5-flash

# Option 2: OpenAI
# LLM_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# Leave blank to use the built-in rule-based engine (recommended for demos)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
